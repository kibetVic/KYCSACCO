@using System.Security.Claims
@model KYCSACCO.Models.ViewModels.UserManagementViewModel

@{
    ViewData["Title"] = "User Management";
    Layout = "_Layout";

    var userRole = User.FindFirstValue(ClaimTypes.Role);
    var userGroup = User.FindFirstValue("UserGroup");

    // Super Admin → sees all companies and can do everything
    var isSuperAdmin = userRole == "Super Admin" || userGroup == "Super Admin";

    // Can CREATE users → System Administrator, Book Keeper, Super Admin
    var canCreateUsers = isSuperAdmin
                      || userRole == "System Administrator"
                      || userGroup == "System Administrator"
                      || userRole == "Book Keeper"
                      || userGroup == "Book Keeper";

    // Can UPDATE (Edit) users → ONLY System Administrator and Super Admin
    var canEditUsers = isSuperAdmin
                    || userRole == "System Administrator"
                    || userGroup == "System Administrator";
}

<div class="container-fluid py-4">
    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>User Management</h2>

        @if (canCreateUsers)
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createUserModal">
                <i class="fas fa-plus"></i> Create New User
            </button>
        }
    </div>

    <!-- Search Bar -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-10">
                    <input type="text" name="searchTerm" class="form-control"
                           placeholder="Search by username, email, or login ID..."
                           value="@Model.SearchTerm" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Username</th>
                            <th>Login ID</th>
                            <th>Role</th>
                            @if (isSuperAdmin)
                            {
                                <th>Company Code</th>
                            }
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Users.Any())
                        {
                            foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td>@user.UserName</td>
                                    <td>@user.UserLoginId</td>
                                    <td>@user.UserGroup</td>
                                    @if (isSuperAdmin)
                                    {
                                        <td>@user.CompanyCode</td>
                                    }
                                    <td>@user.Email</td>
                                    <td>@user.Phone</td>
                                    <td>
                                        @if (user.Status == "Active" && !user.IsLocked)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else if (user.IsLocked)
                                        {
                                            <span class="badge bg-danger">Locked</span>
                                        }
                                        else if (user.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-sm btn-info"
                                                    onclick="viewUser(@user.UserId)" title="View Details">
                                                <i class="fas fa-eye"></i> View
                                            </button>

                                            @if (canEditUsers)
                                            {
                                                <button type="button" class="btn btn-sm btn-warning"
                                                        onclick="editUser(@user.UserId)" title="Edit User">
                                                    <i class="fas fa-edit"></i> Update
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(isSuperAdmin ? 8 : 7)" class="text-center">No users found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create User Modal -->
@if (canCreateUsers)
{
    <div class="modal fade" id="createUserModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-user-plus me-2"></i> New User
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="Create" method="post" id="createUserForm">
                    @Html.AntiForgeryToken()
                    <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">

                        <!-- Company-level warning banner -->
                        <div id="companyWarnings" class="alert alert-warning d-none" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <span id="companyWarningsText"></span>
                        </div>

                        <!-- Account Information -->
                        <div class="form-section-title mb-3">
                            <i class="fas fa-user-circle me-2"></i>Account Information
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Company Code *</label>
                                <select name="CompanyCode" id="CompanyCodeSelect" class="form-control" required style="width: 100%;">
                                    <option value="">-- Select Company --</option>
                                    @if (ViewBag.Companies != null)
                                    {
                                        foreach (var company in ViewBag.Companies)
                                        {
                                            <option value="@company.CompanyCode">@company.DisplayText</option>
                                        }
                                    }
                                </select>
                                <small class="text-muted" id="companyRoleHint"></small>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">User Group/Role *</label>
                                <select name="UserGroup" id="userGroupSelect" class="form-control" required>
                                    <option value="">-- Select Role --</option>
                                    @if (ViewBag.UserGroups != null)
                                    {
                                        foreach (var group in ViewBag.UserGroups)
                                        {
                                            <option value="@group">@group</option>
                                        }
                                    }
                                </select>
                                <span class="text-danger small d-block" id="roleAvailabilityError"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Username *</label>
                                <input type="text" name="UserName" class="form-control" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Email *</label>
                                <input type="email" name="Email" class="form-control" required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Password *</label>
                                <div class="input-group">
                                    <input type="password" name="Password" id="createPassword" class="form-control" required />
                                    <button class="btn btn-outline-secondary" type="button" onclick="toggleCreatePassword()">
                                        <i class="far fa-eye" id="toggleCreateIcon"></i>
                                    </button>
                                </div>
                                <div class="password-strength" id="createPasswordStrength"></div>
                                <span class="text-danger small" id="createPasswordError"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Confirm Password *</label>
                                <div class="input-group">
                                    <input type="password" name="ConfirmPassword" id="createConfirmPassword" class="form-control" required />
                                    <button class="btn btn-outline-secondary" type="button" onclick="toggleCreateConfirmPassword()">
                                        <i class="far fa-eye" id="toggleCreateConfirmIcon"></i>
                                    </button>
                                </div>
                                <span class="text-danger small" id="createConfirmPasswordError"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Phone Number</label>
                                <input type="text" name="Phone" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Department</label>
                                <input type="text" name="Department" class="form-control" />
                            </div>
                        </div>

                        <!-- Location Information -->
                        <div class="form-section-title mb-3 mt-2">
                            <i class="fas fa-map-marker-alt me-2"></i>Location Information
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Sub-County</label>
                                <select name="SubCountyId" class="form-control" id="modalSubCountyId">
                                    <option value="">-- Select Sub-County --</option>
                                    @if (ViewBag.SubCounties != null)
                                    {
                                        foreach (var subCounty in ViewBag.SubCounties)
                                        {
                                            <option value="@subCounty.Id">@subCounty.SubCountyName</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Ward</label>
                                <select name="WardId" class="form-control" id="modalWardId">
                                    <option value="">-- Select Ward --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times me-1"></i>Back
                        </button>
                        <button type="submit" class="btn btn-primary" id="saveUserBtn">
                            <span id="saveUserBtnContent">
                                <i class="fas fa-save me-1"></i>Save User
                            </span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <style>
        .password-strength {
            height: 5px;
            margin-top: 6px;
            border-radius: 3px;
            background-color: #e9ecef;
            overflow: hidden;
            position: relative;
            transition: all 0.3s ease;
        }

            .password-strength::after {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                bottom: 0;
                width: 0%;
                border-radius: 3px;
                background-color: #dc3545;
                transition: width 0.3s ease, background-color 0.3s ease;
            }

            .password-strength.rule-1::after {
                width: 25%;
                background-color: #dc3545;
            }

            .password-strength.rule-2::after {
                width: 50%;
                background-color: #fd7e14;
            }

            .password-strength.rule-3::after {
                width: 75%;
                background-color: #ffc107;
            }

            .password-strength.rule-4::after {
                width: 100%;
                background-color: #28a745;
            }

        .strength-weak {
            width: 33%;
            background-color: #dc3545;
        }

        .strength-medium {
            width: 66%;
            background-color: #ffc107;
        }

        .strength-strong {
            width: 100%;
            background-color: #28a745;
        }

        .select2-container--bootstrap-5 .select2-selection {
            min-height: 38px;
            border-radius: 0.375rem;
        }

        .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
            line-height: 36px;
        }

        .select2-container--bootstrap-5 .select2-dropdown {
            border-color: #dee2e6;
        }

        .select2-container--bootstrap-5 .select2-results__option--highlighted {
            background-color: #0d6efd;
        }

        /* Greyed-out / disabled options in the Role select */
        #userGroupSelect option.role-taken {
            color: #adb5bd;
            background-color: #f8f9fa;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {

            // Cache of role availability for the currently selected company
            // { "Member": true, "Teller": false, ... } → true means taken
            var roleAvailability = {};
            var systemUsersFull = false;

            // ------------------------------------------------------------
            // 1. Select2 init for Company dropdown
            // ------------------------------------------------------------
            if ($('#CompanyCodeSelect').length) {
                $('#CompanyCodeSelect').select2({
                    theme: 'bootstrap-5',
                    placeholder: '-- Select Company --',
                    allowClear: true,
                    width: '100%',
                    dropdownParent: $('#createUserModal'),
                    matcher: function (params, data) {
                        if ($.trim(params.term) === '') return data;

                        var term = params.term.toLowerCase();
                        var text = data.text.toLowerCase();
                        var companyCode = data.element?.value?.toLowerCase() || '';

                        if (companyCode.indexOf(term) > -1 || text.indexOf(term) > -1) {
                            return data;
                        }
                        return null;
                    }
                });

                // Company changed → fetch role availability
                $('#CompanyCodeSelect').on('change', function () {
                    var companyCode = $(this).val();
                    fetchRoleAvailability(companyCode);
                });

                $('#createUserModal').on('hidden.bs.modal', function () {
                    $('#CompanyCodeSelect').val(null).trigger('change');
                    // Reset role UI
                    roleAvailability = {};
                    systemUsersFull = false;
                    $('#companyWarnings').addClass('d-none');
                    $('#companyRoleHint').text('');
                    $('#roleAvailabilityError').text('');
                    $('#userGroupSelect').val('');
                });
            }

            // ------------------------------------------------------------
            // 2. Fetch role availability for a company
            // ------------------------------------------------------------
            function fetchRoleAvailability(companyCode) {
                // Clear previous state
                roleAvailability = {};
                systemUsersFull = false;
                $('#companyWarnings').addClass('d-none').find('#companyWarningsText').text('');
                $('#companyRoleHint').text('');
                $('#roleAvailabilityError').text('');

                if (!companyCode) return;

                $('#companyRoleHint').html(
                    '<i class="fas fa-spinner fa-spin"></i> Checking role availability...'
                );

                $.ajax({
                    url: '@Url.Action("CheckCompanyRoleAvailability", "Account")',
                    type: 'GET',
                    data: { companyCode: companyCode },
                    dataType: 'json',
                    success: function (response) {
                        if (!response || !response.success) {
                            $('#companyRoleHint').text('');
                            return;
                        }

                        systemUsersFull = !!response.systemUsersFull;

                        // Build lookup of taken roles
                        roleAvailability = {};
                        if (response.roles) {
                            response.roles.forEach(function (r) {
                                roleAvailability[r.role] = !!r.isTaken;
                            });
                        }

                        // Update the Role <select>: mark & disable taken options
                        applyRoleAvailabilityToSelect();

                        // Company-level warning for system users
                        if (systemUsersFull) {
                            $('#companyWarnings').removeClass('d-none');
                            $('#companyWarningsText').text(
                                'This company already has ' + response.systemUsersCount + '/' +
                                response.systemUsersLimit + ' system users (Administrator/System Admin). ' +
                                'You cannot assign another system role to this company.'
                            );
                        }

                        $('#companyRoleHint').html(
                            '<i class="fas fa-info-circle text-success"></i> ' +
                            'Roles already assigned to this company are greyed out.'
                        );
                    },
                    error: function () {
                        $('#companyRoleHint').html(
                            '<i class="fas fa-exclamation-triangle text-danger"></i> ' +
                            'Could not verify role availability.'
                        );
                    }
                });
            }

            // ------------------------------------------------------------
            // 3. Apply availability to the Role <select>
            // ------------------------------------------------------------
            function applyRoleAvailabilityToSelect() {
                $('#userGroupSelect option').each(function () {
                    var $opt = $(this);
                    var role = $opt.val();
                    if (!role) return;

                    var isTaken = !!roleAvailability[role];
                    var isSystemRole = /admin/i.test(role);   // quick heuristic; server also enforces

                    if (isTaken || (systemUsersFull && isSystemRole)) {
                        $opt.prop('disabled', true).addClass('role-taken');
                    } else {
                        $opt.prop('disabled', false).removeClass('role-taken');
                    }
                });
            }

            // ------------------------------------------------------------
            // 4. Role selected → immediate feedback
            // ------------------------------------------------------------
            $('#userGroupSelect').on('change', function () {
                var role = $(this).val();
                $('#roleAvailabilityError').text('');

                if (!role) return;

                if (roleAvailability[role]) {
                    $('#roleAvailabilityError').text(
                        "The role '" + role + "' is already assigned to another user in this company."
                    );
                    return;
                }

                if (systemUsersFull && /admin/i.test(role)) {
                    $('#roleAvailabilityError').text(
                        "This company already has the maximum number of system users. " +
                        "You cannot assign '" + role + "'."
                    );
                }
            });

            // ------------------------------------------------------------
            // 5. Password validation
            // ------------------------------------------------------------
            function checkPasswordRules(password) {
                return {
                    length:  password.length >= 8,
                    letter:  /[a-zA-Z]/.test(password),
                    number:  /[0-9]/.test(password),
                    special: /[^a-zA-Z0-9]/.test(password)
                };
            }

            function updatePasswordBar(barSelector, password) {
                var $bar = $(barSelector);
                $bar.removeClass('rule-1 rule-2 rule-3 rule-4');
                if (!password) return;

                var rules = checkPasswordRules(password);
                var met = 0;
                if (rules.length)  met++;
                if (rules.letter)  met++;
                if (rules.number)  met++;
                if (rules.special) met++;

                if (met > 0) $bar.addClass('rule-' + met);
            }

            $('#createPassword').on('input', function () {
                var password = $(this).val();
                updatePasswordBar('#createPasswordStrength', password);

                var rules = checkPasswordRules(password);
                if (rules.length && rules.letter && rules.number && rules.special) {
                    $('#createPasswordError').text('');
                }
            });

            $('#createConfirmPassword').on('input', function () {
                if ($(this).val() === $('#createPassword').val()) {
                    $('#createConfirmPasswordError').text('');
                }
            });

            // ------------------------------------------------------------
            // 6. Final submit-time validation
            //    (client pre-check + spinner only when everything passes)
            // ------------------------------------------------------------
            $('#createUserForm').on('submit', function (e) {
                var password = $('#createPassword').val();
                var confirm  = $('#createConfirmPassword').val();
                var rules    = checkPasswordRules(password);
                var role     = $('#userGroupSelect').val();
                var company  = $('#CompanyCodeSelect').val();
                var isValid  = true;

                // --- Password ---
                if (!rules.length) {
                    $('#createPasswordError').text('Password must be at least 8 characters.');
                    isValid = false;
                } else if (!rules.letter) {
                    $('#createPasswordError').text('Password must contain at least one letter.');
                    isValid = false;
                } else if (!rules.number) {
                    $('#createPasswordError').text('Password must contain at least one number.');
                    isValid = false;
                } else if (!rules.special) {
                    $('#createPasswordError').text('Password must contain at least one special character.');
                    isValid = false;
                } else {
                    $('#createPasswordError').text('');
                }

                if (password !== confirm) {
                    $('#createConfirmPasswordError').text('Passwords do not match.');
                    isValid = false;
                } else {
                    $('#createConfirmPasswordError').text('');
                }

                // --- Company + Role pre-check (the new part) ---
                if (!company) {
                    $('#roleAvailabilityError').text('Please select a company first.');
                    isValid = false;
                } else if (!role) {
                    $('#roleAvailabilityError').text('Please select a role.');
                    isValid = false;
                } else if (roleAvailability[role]) {
                    $('#roleAvailabilityError').text(
                        "The role '" + role + "' is already assigned to another user in this company. " +
                        "Each role can only be assigned once per company."
                    );
                    isValid = false;
                } else if (systemUsersFull && /admin/i.test(role)) {
                    $('#roleAvailabilityError').text(
                        "This company already has the maximum number of system users (Administrator/System Admin). " +
                        "You cannot assign '" + role + "'."
                    );
                    isValid = false;
                } else {
                    $('#roleAvailabilityError').text('');
                }

                if (!isValid) {
                    e.preventDefault();
                    e.stopPropagation();
                    return false;
                }

                // All good → show spinner
                var $btn = $('#saveUserBtn');
                $btn.prop('disabled', true);
                $('#saveUserBtnContent').html(
                    '<span class="spinner-border spinner-border-sm me-2" ' +
                    'role="status" aria-hidden="true"></span>Saving...'
                );

                return true;
            });
        });

        // ================= PASSWORD TOGGLE HELPERS =================
        function toggleCreatePassword() {
            var field = document.getElementById('createPassword');
            var icon  = document.getElementById('toggleCreateIcon');
            if (field.type === 'password') {
                field.type = 'text';
                icon.classList.remove('fa-eye'); icon.classList.add('fa-eye-slash');
            } else {
                field.type = 'password';
                icon.classList.remove('fa-eye-slash'); icon.classList.add('fa-eye');
            }
        }

        function toggleCreateConfirmPassword() {
            var field = document.getElementById('createConfirmPassword');
            var icon  = document.getElementById('toggleCreateConfirmIcon');
            if (field.type === 'password') {
                field.type = 'text';
                icon.classList.remove('fa-eye'); icon.classList.add('fa-eye-slash');
            } else {
                field.type = 'password';
                icon.classList.remove('fa-eye-slash'); icon.classList.add('fa-eye');
            }
        }

        function viewUser(userId) {
            window.location.href = '/Account/Details/' + userId;
        }

        function editUser(userId) {
            window.location.href = '/Account/Edit/' + userId;
        }

        function lockUser(userId) {
            if (confirm('Are you sure you want to lock this user?')) {
                $.post('/Account/LockUser', { userId: userId }, function (response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message || 'Error locking user');
                    }
                });
            }
        }

        function unlockUser(userId) {
            if (confirm('Are you sure you want to unlock this user?')) {
                $.post('/Account/UnlockUser', { userId: userId }, function (response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message || 'Error unlocking user');
                    }
                });
            }
        }

        // Modal subcounty change - load wards
        $(document).on('change', '#modalSubCountyId', function () {
            var subCountyId = $(this).val();
            if (subCountyId) {
                $.getJSON('/Account/GetWardsBySubCounty', { subCountyId: subCountyId }, function (data) {
                    var wardSelect = $('#modalWardId');
                    wardSelect.empty();
                    wardSelect.append('<option value="">-- Select Ward --</option>');
                    $.each(data, function (index, ward) {
                        wardSelect.append('<option value="' + ward.id + '">' + ward.wardName + '</option>');
                    });
                });
            } else {
                $('#modalWardId').empty().append('<option value="">-- Select Ward --</option>');
            }
        });

        // If the user hits Back, re-enable the Save User button.
        window.addEventListener('pageshow', function (event) {
            if (event.persisted) {
                $('#saveUserBtn').prop('disabled', false);
                $('#saveUserBtnContent').html('<i class="fas fa-save me-1"></i>Save User');
            }
        });
    </script>
}