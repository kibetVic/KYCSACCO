@model KYCSACCO.Models.ViewModels.EditUserVm

@{
    ViewData["Title"] = "Edit User";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-user-edit me-2"></i>Edit User
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" id="editUserForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="UserLoginId" />
                        <input type="hidden" asp-for="DateCreated" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Company-level warning banner (system users full etc.) -->
                        <div id="companyWarnings" class="alert alert-warning d-none" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <span id="companyWarningsText"></span>
                        </div>

                        <!-- Account Information -->
                        <div class="form-section-title mb-3">
                            <i class="fas fa-user-circle me-2"></i>Account Information
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserName" class="form-label">Username *</label>
                                <input asp-for="UserName" class="form-control" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserLoginId" class="form-label">Login ID</label>
                                <input asp-for="UserLoginId" class="form-control" readonly disabled />
                                <small class="text-muted">Login ID is auto-generated and cannot be changed</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label">Email *</label>
                                <input asp-for="Email" type="email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Phone" class="form-label">Phone Number</label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Department" class="form-label">Department</label>
                                <input asp-for="Department" class="form-control" />
                                <span asp-validation-for="Department" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserGroup" class="form-label">User Group/Role *</label>
                                <select asp-for="UserGroup" id="userGroupSelect" class="form-control" required>
                                    <option value="">-- Select Role --</option>
                                    @if (ViewBag.UserGroups != null)
                                    {
                                        foreach (var group in ViewBag.UserGroups)
                                        {
                                            <option value="@group">@group</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="UserGroup" class="text-danger"></span>
                                <span class="text-danger small d-block" id="roleAvailabilityError"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CompanyCode" class="form-label">Company Code *</label>
                                <select asp-for="CompanyCode" id="CompanyCodeSelect" class="form-control" required>
                                    <option value="">-- Select Company --</option>
                                    @if (ViewBag.Companies != null)
                                    {
                                        foreach (var company in ViewBag.Companies)
                                        {
                                            <option value="@company.CompanyCode">@company.DisplayText</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="CompanyCode" class="text-danger"></span>
                                <small class="text-muted" id="companyRoleHint"></small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Status" class="form-label">Status</label>
                                <select asp-for="Status" class="form-control">
                                    @foreach (var status in Model.AvailableStatuses)
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Location Information -->
                        <div class="form-section-title mb-3 mt-2">
                            <i class="fas fa-map-marker-alt me-2"></i>Location Information
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SubCountyId" class="form-label">Sub-County</label>
                                <select asp-for="SubCountyId" class="form-control" id="SubCountyId">
                                    <option value="">-- Select Sub-County --</option>
                                    @if (ViewBag.SubCounties != null)
                                    {
                                        foreach (var subCounty in ViewBag.SubCounties)
                                        {
                                            <option value="@subCounty.Id">@subCounty.SubCountyName</option>
                                        }
                                    }
                                </select>
                                <input type="hidden" asp-for="SubCounty" />
                                <span asp-validation-for="SubCountyId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="WardId" class="form-label">Ward</label>
                                <select asp-for="WardId" class="form-control" id="WardId">
                                    <option value="">-- Select Ward --</option>
                                </select>
                                <input type="hidden" asp-for="Ward" />
                                <span asp-validation-for="WardId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Additional Info -->
                        <div class="form-section-title mb-3 mt-2">
                            <i class="fas fa-info-circle me-2"></i>Additional Information
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Date Created</label>
                                <input type="text" value="@(Model.DateCreated?.ToString("yyyy-MM-dd HH:mm:ss") ?? "N/A")"
                                       class="form-control" readonly disabled />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Lock Status</label>
                                <div class="form-control-plaintext">
                                    @if (Model.IsLocked)
                                    {
                                        <span class="badge bg-danger">Locked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Unlocked</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Form Buttons -->
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Back to List
                            </a>
                            <button type="submit" class="btn btn-primary" id="saveChangesBtn">
                                <span id="saveChangesBtnContent">
                                    <i class="fas fa-save me-1"></i>Save Changes
                                </span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Greyed-out / disabled options in the Role select */
        #userGroupSelect option.role-taken {
            color: #adb5bd;
            background-color: #f8f9fa;
        }

        /* Highlight the user's current role */
        #userGroupSelect option.current-role {
            font-weight: 600;
            color: #0d6efd;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // Get current values from the model (rendered as HTML)
            var currentSubCountyId = @(Model.SubCountyId.HasValue? Model.SubCountyId.Value.ToString() : "0");
            var currentWardId = @(Model.WardId.HasValue? Model.WardId.Value.ToString() : "0");
            var editingUserId = @Model.UserId;

            console.log("Current SubCountyId:", currentSubCountyId);
            console.log("Current WardId:", currentWardId);
            console.log("Editing UserId:", editingUserId);

            // ============================================================
            // Role availability state
            // ============================================================
            var roleAvailability = {};       // { "Member": true/false }  true = taken
            var systemUsersFull = false;
            var currentUsersRole = null;

            // ============================================================
            // Load role availability for the currently selected company
            // ============================================================
            function fetchRoleAvailability(companyCode) {
                roleAvailability = {};
                systemUsersFull = false;
                currentUsersRole = null;
                $('#companyWarnings').addClass('d-none').find('#companyWarningsText').text('');
                $('#companyRoleHint').text('');
                $('#roleAvailabilityError').text('');

                if (!companyCode) return;

                $('#companyRoleHint').html(
                    '<i class="fas fa-spinner fa-spin"></i> Checking role availability...'
                );

                $.ajax({
                    url: '@Url.Action("CheckCompanyRoleAvailabilityForEdit", "Account")',
                    type: 'GET',
                    data: { companyCode: companyCode, userId: editingUserId },
                    dataType: 'json',
                    success: function (response) {
                        if (!response || !response.success) {
                            $('#companyRoleHint').text('');
                            return;
                        }

                        systemUsersFull = !!response.systemUsersFull;
                        currentUsersRole = response.currentUserRole;

                        roleAvailability = {};
                        if (response.roles) {
                            response.roles.forEach(function (r) {
                                roleAvailability[r.role] = !!r.isTaken;
                            });
                        }

                        // Save the user's currently-selected role BEFORE we modify options
                        var selectedRole = $('#userGroupSelect').val();

                        applyRoleAvailabilityToSelect(selectedRole);

                        // Company-level warning for system users
                        if (systemUsersFull && !isSystemRole(selectedRole)) {
                            $('#companyWarnings').removeClass('d-none');
                            $('#companyWarningsText').text(
                                'This company already has ' + response.systemUsersCount + '/' +
                                response.systemUsersLimit + ' system users (Administrator/System Admin). ' +
                                'You cannot promote this user to a system role.'
                            );
                        }

                        $('#companyRoleHint').html(
                            '<i class="fas fa-info-circle text-success"></i> ' +
                            'Roles already assigned to this company are greyed out. ' +
                            'The current user\u2019s role is highlighted in blue.'
                        );
                    },
                    error: function () {
                        $('#companyRoleHint').html(
                            '<i class="fas fa-exclamation-triangle text-danger"></i> ' +
                            'Could not verify role availability.'
                        );
                    }
                });
            }

            // Quick client-side heuristic to detect system roles by name
            function isSystemRole(role) {
                if (!role) return false;
                return /admin/i.test(role);
            }

            // ============================================================
            // Apply availability to the Role <select>
            // - taken roles (by OTHER users) -> disabled
            // - current user's own role       -> enabled + highlighted
            // - system roles when full        -> disabled (unless it's the user's own)
            // ============================================================
            function applyRoleAvailabilityToSelect(selectedRole) {
                $('#userGroupSelect option').each(function () {
                    var $opt = $(this);
                    var role = $opt.val();
                    if (!role) return;

                    var isTaken = !!roleAvailability[role];
                    var isOwnRole = currentUsersRole &&
                                    role.toLowerCase() === currentUsersRole.toLowerCase();

                    // Reset
                    $opt.removeClass('role-taken current-role').prop('disabled', false);

                    if (isOwnRole) {
                        // The user's own role — always available, highlight it
                        $opt.addClass('current-role');
                        return;
                    }

                    if (isTaken) {
                        $opt.prop('disabled', true).addClass('role-taken');
                        return;
                    }

                    if (systemUsersFull && isSystemRole(role)) {
                        $opt.prop('disabled', true).addClass('role-taken');
                    }
                });

                // Restore the previous selection if still valid
                if (selectedRole) {
                    var $selected = $('#userGroupSelect option[value="' + selectedRole + '"]');
                    if ($selected.length && !$selected.prop('disabled')) {
                        $('#userGroupSelect').val(selectedRole);
                    }
                }
            }

            // ============================================================
            // Company changed -> re-check
            // ============================================================
            $('#CompanyCodeSelect').on('change', function () {
                var companyCode = $(this).val();
                fetchRoleAvailability(companyCode);
            });

            // ============================================================
            // Role changed -> inline feedback
            // ============================================================
            $('#userGroupSelect').on('change', function () {
                var role = $(this).val();
                $('#roleAvailabilityError').text('');

                if (!role) return;

                var isOwnRole = currentUsersRole &&
                                role.toLowerCase() === currentUsersRole.toLowerCase();

                if (!isOwnRole && roleAvailability[role]) {
                    $('#roleAvailabilityError').text(
                        "The role '" + role + "' is already assigned to another user in this company."
                    );
                    return;
                }

                if (!isOwnRole && systemUsersFull && isSystemRole(role)) {
                    $('#roleAvailabilityError').text(
                        "This company already has the maximum number of system users. " +
                        "You cannot assign '" + role + "'."
                    );
                }
            });

            // ============================================================
            // Sub-County / Ward logic (unchanged)
            // ============================================================
            if (currentSubCountyId !== "0" && currentSubCountyId !== "") {
                loadWards(currentSubCountyId, currentWardId);
            }

            $('#SubCountyId').change(function () {
                var subCountyId = $(this).val();
                console.log("SubCounty changed to:", subCountyId);

                if (subCountyId && subCountyId !== "0") {
                    loadWards(subCountyId, null);
                    var subCountyName = $('#SubCountyId option:selected').text();
                    $('#SubCounty').val(subCountyName);
                } else {
                    $('#WardId').empty().append('<option value="">-- Select Ward --</option>');
                    $('#WardId').val('');
                    $('#Ward').val('');
                }
            });

            $('#WardId').change(function () {
                var wardName = $('#WardId option:selected').text();
                $('#Ward').val(wardName);
                console.log("Ward selected:", wardName);
            });

            function loadWards(subCountyId, selectedWardId) {
                console.log("Loading wards for SubCountyId:", subCountyId);

                $.ajax({
                    url: '/Account/GetWardsBySubCounty',
                    type: 'GET',
                    data: { subCountyId: subCountyId },
                    dataType: 'json',
                    success: function (data) {
                        console.log("Wards received:", data);
                        var wardSelect = $('#WardId');
                        wardSelect.empty();
                        wardSelect.append('<option value="">-- Select Ward --</option>');

                        if (data && data.length > 0) {
                            $.each(data, function (index, ward) {
                                var selected = (selectedWardId && selectedWardId == ward.id) ? 'selected' : '';
                                wardSelect.append('<option value="' + ward.id + '" ' + selected + '>' + ward.wardName + '</option>');
                            });

                            if (selectedWardId) {
                                var selectedWardName = $('#WardId option:selected').text();
                                $('#Ward').val(selectedWardName);
                                console.log("Selected ward name set to:", selectedWardName);
                            }
                        } else {
                            console.log("No wards found for this subcounty");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error loading wards:", error);
                        console.log("Response text:", xhr.responseText);
                    }
                });
            }

            // ============================================================
            // INITIAL LOAD: run the role-availability check for the
            // company currently selected (the user being edited).
            // ============================================================
            var initialCompany = $('#CompanyCodeSelect').val();
            if (initialCompany) {
                fetchRoleAvailability(initialCompany);
            }

            // ============================================================
            // SUBMIT: pre-check + spinner
            // ============================================================
            $('#editUserForm').on('submit', function (e) {
                var role = $('#userGroupSelect').val();
                var company = $('#CompanyCodeSelect').val();
                var isValid = true;

                // Clear previous inline error
                $('#roleAvailabilityError').text('');

                if (!company) {
                    $('#roleAvailabilityError').text('Please select a company.');
                    isValid = false;
                } else if (!role) {
                    $('#roleAvailabilityError').text('Please select a role.');
                    isValid = false;
                } else {
                    var isOwnRole = currentUsersRole &&
                                    role.toLowerCase() === currentUsersRole.toLowerCase();

                    if (!isOwnRole && roleAvailability[role]) {
                        $('#roleAvailabilityError').text(
                            "The role '" + role + "' is already assigned to another user in this company. " +
                            "Each role can only be assigned once per company."
                        );
                        isValid = false;
                    } else if (!isOwnRole && systemUsersFull && isSystemRole(role)) {
                        $('#roleAvailabilityError').text(
                            "This company already has the maximum number of system users (Administrator/System Admin). " +
                            "You cannot assign '" + role + "'."
                        );
                        isValid = false;
                    }
                }

                if (!isValid) {
                    e.preventDefault();
                    e.stopPropagation();
                    return false;
                }

                // All good → show spinner
                var $btn = $('#saveChangesBtn');
                $btn.prop('disabled', true);
                $('#saveChangesBtnContent').html(
                    '<span class="spinner-border spinner-border-sm me-2" ' +
                    'role="status" aria-hidden="true"></span>Saving...'
                );

                return true;
            });
        });

        // If the user hits Back, re-enable the Save Changes button.
        window.addEventListener('pageshow', function (event) {
            if (event.persisted) {
                $('#saveChangesBtn').prop('disabled', false);
                $('#saveChangesBtnContent').html('<i class="fas fa-save me-1"></i>Save Changes');
            }
        });
    </script>
}